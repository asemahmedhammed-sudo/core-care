{#
| Variable     | Type                  | Description |
|--------------|-----------------------|-------------|
| page         | Page                  |             |
| page.title   | string                |             |
| page.content | string                |             |
| page.url     | string                |             |
| page.slug    | string                |             |
| page.type    | string                |             |
#}
{% extends "layouts.master" %}
{% block content %}
    {% set policy_page_id = theme.settings.get('beauty_policy_page_id', '')|trim %}
    {# Without a configured ID, a page titled as the returns policy uses the policy design. #}
    {% set page_title = page.title|default('')|lower %}
    {% set is_policy_title = 'الاسترجاع' in page_title or 'الاستبدال' in page_title or 'return' in page_title or 'refund' in page_title %}
    {% set is_policy_page = policy_page_id ? policy_page_id == (page.id ~ '') : is_policy_title %}
    {% if is_policy_page %}
      <article class="container core-policy" aria-labelledby="core-policy-title">
        {% include 'pages.partials.return-policy-intro' %}
        {# Text written in Salla's page editor (محرر النصوص) appears here, so merchants can
           edit and add policy details from the page itself. Same trusted merchant content and
           output as the inherited page body below. #}
        {% if page.content|default('')|trim %}
          <section class="core-policy__section core-policy__content content-entry">{{ page.content|raw }}</section>
        {% endif %}
        {# Elements added from the editor's page sections (customised pages only). #}
        {% if page.type == 'customised' %}
          <div class="s-blocks-wrapper s-information-page core-policy__blocks">{% hook 'information_page.information_page' %}</div>
        {% endif %}
        {% include 'pages.partials.return-policy' %}
      </article>
    {% elseif page.type == 'customised' %}
      {#
          Hook: information_page.information_page
          Fires before the main informative page content section.
          Use this hook to inject custom content or components above the page content area.
      #}
      <div class="s-blocks-wrapper s-information-page !mt-0">{% hook 'information_page.information_page' %}</div>
    {% else %}
      <div class="container">
          {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>

          <div class="flex justify-center">
              <div class="content content--single-page w-full lg:w-10/12 bg-white rounded p-6 lg:p-8 mt-4 lg:mt-12">
                  <h1 class="font-bold text-2xl mb-6">{{ page.title }}</h1>
                  <div class="content-entry">
                      {{ page.content|raw }}
                  </div>
                  <salla-comments data-testid="store-page-comments" item-id="{{page.id}}" type="page"></salla-comments>
              </div>
          </div>
      </div>
    {% endif %}
{% endblock %}
