{# Bottom tab bar for phones (below 768px), after the Nice One app reference.
   Cart and account move here from the header on those widths; larger screens keep the desktop header.
   The bar steps aside on phone product pages when Salla's sticky add-to-cart bar takes the bottom edge. #}
{% set center_icon = { image: theme.settings.get('beauty_tabbar_center_image'), image_en: theme.settings.get('beauty_tabbar_center_image_en') } %}
{% set center_image %}{% include 'pages.partials.localized-image' with { item: center_icon, field: 'image' } %}{% endset %}
{% set center_url = theme.settings.get('beauty_tabbar_center_url')|default('')|trim %}
{# Plain Twig operators keep link validation independent of regex support, as in the promotions slider. #}
{% set center_valid = center_url|lower starts with 'https://' and center_url|length > 8 and ' ' not in center_url and '"' not in center_url and '<' not in center_url and '>' not in center_url %}
{# Multilanguage settings arrive as per-language arrays; resolve the current language before string filters. #}
{% set center_label = theme.settings.get('beauty_tabbar_center_label') %}
{% set center_label = (center_label is iterable ? center_label[language.code]|default(center_label|first) : center_label)|default('')|trim %}
{# Campaign button: a built-in white line icon on a coloured disc (merchant's choice), or the merchant's own image. #}
{% set center_mode = theme.settings.get('beauty_tabbar_center_icon', 'ribbon')|default('ribbon') %}
{% set center_mode = center_mode in ['ribbon', 'gift', 'tag', 'sparkle', 'heart', 'image', 'none'] ? center_mode : 'ribbon' %}
{% set center_style = theme.settings.get('beauty_tabbar_center_style', 'pink')|default('pink') %}
{% set center_style = center_style in ['pink', 'purple', 'dark'] ? center_style : 'pink' %}
{% set center_show = center_valid and center_mode != 'none' and (center_mode != 'image' or center_image) %}
{% set yield_to_product_bar = page.slug == 'product.single' and theme.settings.get('sticky_add_to_cart') %}
<nav class="cc-tabbar{{ yield_to_product_bar ? ' cc-tabbar--yield' : '' }}" data-testid="store-tabbar" aria-label="{{ trans('beauty.tabbar.label') }}">
  <ul class="cc-tabbar__list">
    <li>
      <a class="cc-tabbar__item" href="{{ link('/') }}"{% if is_page('index') %} aria-current="page"{% endif %}>
        <svg class="cc-tabbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="cc-tabbar__fill" d="M10.6 3.6a2.3 2.3 0 0 1 2.8 0l6 4.6c.6.5 1 1.2 1 2V18a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4.4 18v-7.8c0-.8.4-1.5 1-2Z"/><path d="M10.5 16.5h3"/></svg>
        <span class="cc-tabbar__label">{{ trans('beauty.tabbar.home') }}</span>
      </a>
    </li>
    <li>
      {# Opens the same categories panel as the header trigger; core-care-categories keeps both in sync. #}
      <button class="cc-tabbar__item" type="button" data-categories-toggle aria-expanded="false" aria-controls="core-care-categories">
        <svg class="cc-tabbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect class="cc-tabbar__fill" x="3.5" y="3.5" width="7" height="7" rx="2.5"/><rect class="cc-tabbar__fill" x="13.5" y="3.5" width="7" height="7" rx="2.5"/><rect class="cc-tabbar__fill" x="3.5" y="13.5" width="7" height="7" rx="2.5"/><circle class="cc-tabbar__fill" cx="16.8" cy="16.8" r="3.3"/><path d="m19.3 19.3 1.7 1.7"/></svg>
        <span class="cc-tabbar__label">{{ trans('beauty.tabbar.categories') }}</span>
      </button>
    </li>
    {% if center_show %}
    <li>
      {% if center_mode == 'image' %}
      <a class="cc-tabbar__item cc-tabbar__item--campaign" href="{{ center_url|e('html_attr') }}">
        <img class="cc-tabbar__campaign" src="{{ center_image }}" alt="{{ (center_label ?: trans('beauty.tabbar.campaign'))|e('html_attr') }}" width="48" height="48" loading="lazy" decoding="async">
      {% else %}
      <a class="cc-tabbar__item cc-tabbar__item--campaign" href="{{ center_url|e('html_attr') }}" aria-label="{{ (center_label ?: trans('beauty.tabbar.campaign'))|e('html_attr') }}">
        <span class="cc-tabbar__fab cc-tabbar__fab--{{ center_style }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- if center_mode == 'gift' -%}
            <rect x="4" y="9" width="16" height="4" rx="1"/><path d="M5.5 13v5.5A1.5 1.5 0 0 0 7 20h10a1.5 1.5 0 0 0 1.5-1.5V13M12 9v11M12 9C10.6 5.8 7.5 5.6 7.5 7.4 7.5 8.6 9.5 9 12 9Zm0 0c1.4-3.2 4.5-3.4 4.5-1.6C16.5 8.6 14.5 9 12 9Z"/>
            {%- elseif center_mode == 'tag' -%}
            <path d="M3.5 11.4V5A1.5 1.5 0 0 1 5 3.5h6.4c.4 0 .8.2 1.1.4l7.6 7.6a1.5 1.5 0 0 1 0 2.1l-6.5 6.5a1.5 1.5 0 0 1-2.1 0l-7.6-7.6a1.5 1.5 0 0 1-.4-1.1Z"/><circle cx="8" cy="8" r="1.4"/>
            {%- elseif center_mode == 'sparkle' -%}
            <path d="M11 4.5 12.8 9l4.5 1.8-4.5 1.8L11 17.1l-1.8-4.5-4.5-1.8L9.2 9Z"/><path d="M18 15.5v4M16 17.5h4"/>
            {%- elseif center_mode == 'heart' -%}
            <path d="M12 19.5s-7-4.2-7-9.4A4 4 0 0 1 12 7.6a4 4 0 0 1 7 2.5c0 5.2-7 9.4-7 9.4Z"/>
            {%- else -%}
            <path d="M7.2 21 13.3 12C15 9.4 15.6 7.6 15.6 6.3a3.6 3.6 0 0 0-7.2 0c0 1.3.6 3.1 2.3 5.7l6.1 9" stroke-width="2.2" stroke-linecap="butt"/>
            {%- endif -%}
          </svg>
        </span>
      {% endif %}
        {% if center_label %}<span class="cc-tabbar__label" aria-hidden="true">{{ center_label }}</span>{% endif %}
      </a>
    </li>
    {% endif %}
    <li>
      {# Salla's cart summary keeps the live count; the cart drawer intercepts its link, which still opens the cart page without JavaScript. #}
      {# Salla renders "0" for an empty cart; data-empty hides that badge until core-care-tabbar.js tracks the live count. #}
      <salla-cart-summary class="cc-tabbar__cart{{ is_page('cart') ? ' is-active' : '' }}" data-testid="store-tabbar-cart"{% if not cart.items_count|default(0) %} data-empty{% endif %}>
        <span slot="icon" class="cc-tabbar__item">
          <svg class="cc-tabbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="cc-tabbar__fill" d="M7.2 9h9.6a2.5 2.5 0 0 1 2.4 1.9l1.2 5.4a3.4 3.4 0 0 1-3.3 4.2H6.9a3.4 3.4 0 0 1-3.3-4.2l1.2-5.4A2.5 2.5 0 0 1 7.2 9Z"/><path d="M8.5 9V7.5a3.5 3.5 0 0 1 7 0V9"/><path d="M10.8 12.5h2.4"/></svg>
          <span class="cc-tabbar__label">{{ trans('beauty.tabbar.cart') }}</span>
        </span>
      </salla-cart-summary>
    </li>
    <li>
      {% set account_icon %}<svg class="cc-tabbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle class="cc-tabbar__fill" cx="12" cy="7.5" r="3.8"/><path class="cc-tabbar__fill" d="M5.2 20.5h13.6c.5 0 .8-.4.7-.9-.8-3.1-3.8-5.1-7.5-5.1s-6.7 2-7.5 5.1c-.1.5.2.9.7.9Z"/></svg>{% endset %}
      {# Opens «حسابي» (mobile-account.twig) for guests and customers alike; marked current on the account pages. #}
      <button class="cc-tabbar__item{{ page.slug starts with 'customer.' ? ' is-active' : '' }}" type="button" data-account-toggle aria-expanded="false" aria-controls="cc-account">
        {{ account_icon }}
        <span class="cc-tabbar__label">{{ trans('beauty.tabbar.account') }}</span>
      </button>
    </li>
  </ul>
</nav>
{% include 'pages.partials.mobile-account' %}
