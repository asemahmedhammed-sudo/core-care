{# «تسوّق بمساعدك الذكي»: the shopper can ask straight away from the top of the page; how it works and the optional
   ways to connect an assistant follow, technical details collapsed. Rendered by page-single for the page whose id is
   in core_care_ai_page_id. Merchant text from Salla's page editor (ai_page_content from page-single) shows under the
   top section. Store links and the MCP address are built at runtime by ask-ai.js. #}
{% set t = 'beauty.ai_page.' %}
<article class="container cc-ai-page" aria-labelledby="cc-ai-title">
  <nav class="cc-ai-page__breadcrumbs" aria-label="{{ trans('beauty.policy.breadcrumbs') }}"><salla-breadcrumb></salla-breadcrumb></nav>

  <section class="cc-ai-page__hero">
    <header class="cc-ai-page__intro">
      <span class="cc-ai-page__badge">{% include 'pages.partials.ai-icon' with { name: 'sparkle' } %}{{ trans(t ~ 'eyebrow') }}</span>
      <h1 id="cc-ai-title">{{ page.title|default(trans(t ~ 'title')) }}</h1>
      <p class="cc-ai-page__lead">{{ trans(t ~ 'lead') }}</p>
    </header>
    <div class="cc-ai-page__composer" id="cc-ai-try">
      <h2>{{ trans(t ~ 'try_title') }}</h2>
      {% include 'pages.partials.ask-ai' with { ask_id: 'ask-ai-store', ask_group: 'store', ask_name: store.name, ask_url: store.url } %}
    </div>
    <ul class="cc-ai-page__promises">
      {% for item in [{ icon: 'pay', key: 'promise_pay' }, { icon: 'chat', key: 'promise_choice' }, { icon: 'lock', key: 'promise_privacy' }] %}
        <li><span class="cc-ai-page__icon">{% include 'pages.partials.ai-icon' with { name: item.icon } %}</span><span>{{ trans(t ~ item.key) }}</span></li>
      {% endfor %}
    </ul>
  </section>

  {# Merchant text from Salla's page editor, prepared by page-single.twig. #}
  {{ ai_page_content|default('') }}

  <section class="cc-ai-page__section" aria-labelledby="cc-ai-how">
    <h2 id="cc-ai-how">{{ trans(t ~ 'how_title') }}</h2>
    <ol class="cc-ai-page__steps">
      {% for item in [{ icon: 'chat', key: 'how_ask' }, { icon: 'sparkle', key: 'how_answer' }, { icon: 'bag', key: 'how_buy' }] %}
        <li class="cc-ai-step">
          <span class="cc-ai-page__icon cc-ai-page__icon--large">{% include 'pages.partials.ai-icon' with { name: item.icon } %}</span>
          <div>
            <h3>{{ trans(t ~ item.key ~ '_title') }}</h3>
            <p>{{ trans(t ~ item.key ~ '_text') }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
    <p class="cc-ai-page__tip">
      <span>{{ trans(t ~ 'tip_text') }}</span>
      <a href="{{ link('latest-products') }}">{{ trans(t ~ 'tip_cta') }}</a>
    </p>
  </section>

  <section class="cc-ai-page__section" aria-labelledby="cc-ai-more">
    <h2 id="cc-ai-more">{{ trans(t ~ 'more_title') }}</h2>
    <p class="cc-ai-page__section-lead">{{ trans(t ~ 'more_text') }}</p>
    <div class="cc-ai-page__ways">
      <details class="cc-ai-way">
        <summary>
          <span class="cc-ai-page__icon">{% include 'pages.partials.ai-icon' with { name: 'connect' } %}</span>
          <span class="cc-ai-way__heading"><strong>{{ trans(t ~ 'way_connect_title') }}</strong><small>{{ trans(t ~ 'way_connect_summary') }}</small></span>
          <i class="sicon-keyboard_arrow_down" aria-hidden="true"></i>
        </summary>
        <div class="cc-ai-way__body">
          <p>{{ trans(t ~ 'way_connect_text') }}</p>
          <div class="cc-ai-way__code" data-ai-mcp data-store-url="{{ store.url }}" hidden>
            <code dir="ltr" data-ai-mcp-url></code>
            <button type="button" data-ai-copy-value data-label-copied="{{ trans('beauty.ai_ask.copied') }}">{{ trans(t ~ 'copy_address') }}</button>
          </div>
          <p class="cc-ai-way__note">{{ trans(t ~ 'way_connect_note') }}</p>
        </div>
      </details>
      <details class="cc-ai-way" data-ai-browser-way>
        <summary>
          <span class="cc-ai-page__icon">{% include 'pages.partials.ai-icon' with { name: 'browser' } %}</span>
          <span class="cc-ai-way__heading"><strong>{{ trans(t ~ 'way_browser_title') }}</strong><small>{{ trans(t ~ 'way_browser_summary') }}</small></span>
          <i class="sicon-keyboard_arrow_down" aria-hidden="true"></i>
        </summary>
        <div class="cc-ai-way__body">
          <p>{{ trans(t ~ 'way_browser_text') }}</p>
          <p class="cc-ai-way__status" data-ai-browser-status
             data-label-ready="{{ trans(t ~ 'browser_ready') }}"
             data-label-not-ready="{{ trans(t ~ 'browser_not_ready') }}" hidden></p>
        </div>
      </details>
    </div>
  </section>

  <section class="cc-ai-page__section" aria-labelledby="cc-ai-trust">
    <h2 id="cc-ai-trust">{{ trans(t ~ 'trust_title') }}</h2>
    <p class="cc-ai-page__section-lead">{{ trans(t ~ 'trust_text') }}</p>
    <div class="cc-ai-page__trust">
      <div class="cc-ai-trust cc-ai-trust--can">
        <h3>{{ trans(t ~ 'can_title') }}</h3>
        <ul>{% for key in ['can_search', 'can_compare', 'can_cart', 'can_coupon'] %}<li>{% include 'pages.partials.ai-icon' with { name: 'check' } %}<span>{{ trans(t ~ key) }}</span></li>{% endfor %}</ul>
      </div>
      <div class="cc-ai-trust cc-ai-trust--cannot">
        <h3>{{ trans(t ~ 'cannot_title') }}</h3>
        <ul>{% for key in ['cannot_pay', 'cannot_data', 'cannot_hidden'] %}<li>{% include 'pages.partials.ai-icon' with { name: 'close' } %}<span>{{ trans(t ~ key) }}</span></li>{% endfor %}</ul>
      </div>
    </div>
  </section>
</article>
