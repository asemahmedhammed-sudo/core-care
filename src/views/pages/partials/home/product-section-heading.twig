{% if section_title or (display_all_url and display_all_url != '#') %}
  <div class="beauty-product-section__heading">
    {% if section_title %}<div><h2>{{ section_title }}</h2>{% if section_subtitle %}<p>{{ section_subtitle }}</p>{% endif %}</div>{% endif %}
    {% if display_all_url and display_all_url != '#' %}<a href="{{ display_all_url }}" class="beauty-product-section__all">{{ trans('blocks.home.display_all') }}</a>{% endif %}
  </div>
{% endif %}
