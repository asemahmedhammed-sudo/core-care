{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="store-header">
  <salla-advertisement data-testid="beauty-announcement"></salla-advertisement>
  <div class="core-care-header__band">
    <div class="container core-care-header__top">
      <a data-testid="store-header-logo" class="core-care-header__brand" href="{{ link('/') }}" aria-label="{{ store.name }}">
        {% if store.logo %}
          <img src="{{ store.logo | cdn(400) }}" width="170" height="59" fetchpriority="high" alt="{{ store.name }}">
        {% else %}
          {{ theme.settings.get('beauty_brand_name', store.name) }}
        {% endif %}
      </a>
      <salla-search class="core-care-header__search" data-testid="store-header-search" inline height="45"></salla-search>
      <p class="core-care-header__tagline"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="m8 14-2 8 6-3 6 3-2-8"/></svg>{{ trans('beauty.header.tagline') }}</p>
    </div>
  </div>
  <div id="mainnav" data-header-sticky="{{ theme.settings.get('header_is_sticky', true) ? 'true' : 'false' }}" class="main-nav-container core-care-header">
    <div class="container core-care-header__bottom">
      <nav class="core-care-header__links" aria-label="{{ trans('beauty.open_menu') }}">
        <button data-testid="store-header-mobile-toggle" data-categories-toggle type="button" aria-expanded="false" aria-controls="core-care-categories"><i class="sicon-menu" aria-hidden="true"></i><span>{{ trans('beauty.header.categories') }}</span><i class="sicon-keyboard_arrow_down" aria-hidden="true"></i></button>
        <a href="{{ link('brands') }}">{{ trans('beauty.header.brands') }}</a>
      </nav>
      <div class="core-care-header__actions">
        {% if store.scope %}<button class="core-care-header__scope" type="button" aria-label="{{ store.scope.name }}" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})"><i class="sicon-location" aria-hidden="true"></i><span>{{ store.scope.name }}</span></button>{% endif %}
        {% if store.settings.is_multilingual %}
          {# Inline language dropdown (Nice One style). Languages and switching come from Salla at runtime. #}
          <core-care-language-menu class="core-care-language-menu" data-current="{{ language.code }}" data-error-label="{{ trans('beauty.header.languages_error') }}">
            <button class="core-care-header__locale" type="button" data-language-toggle aria-expanded="false" aria-controls="core-care-language-panel" aria-label="{{ trans('beauty.header.language') }}: {{ language.code|upper }}">
              <svg class="core-care-header__locale-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
              <span class="core-care-header__locale-label">{{ language.code|upper }}</span>
              <svg class="core-care-header__locale-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
            </button>
            {# Phones show the panel as a bottom sheet over this backdrop; hidden on larger screens. #}
            <div class="core-care-language-menu__backdrop" data-language-backdrop hidden></div>
            <div class="core-care-language-menu__panel" id="core-care-language-panel" data-language-panel tabindex="-1" hidden>
              <div class="core-care-language-menu__head">
                <p class="core-care-language-menu__title" id="core-care-language-title">{{ trans('beauty.header.languages') }}</p>
                <button class="core-care-language-menu__close" type="button" data-language-close aria-label="{{ trans('beauty.header.close_languages') }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
              </div>
              <div class="core-care-language-menu__list" data-language-list role="group" aria-labelledby="core-care-language-title"></div>
              {% if store.settings.currencies_enabled %}
                <button class="core-care-language-menu__currency" type="button" data-currency-open aria-haspopup="dialog">{{ trans('beauty.header.currency') }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 7-5 5 5 5"/></svg></button>
              {% endif %}
            </div>
          </core-care-language-menu>
        {% elseif store.settings.currencies_enabled %}
          <button class="core-care-header__locale" type="button" data-testid="store-header-localization-trigger" aria-haspopup="dialog" aria-label="{{ trans('beauty.header.currency') }}" onclick="salla.event.dispatch('localization::open')">
            <svg class="core-care-header__locale-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6.5 9.5v5M17.5 9.5v5"/></svg>
            <span class="core-care-header__locale-label">{{ trans('beauty.header.currency') }}</span>
            <svg class="core-care-header__locale-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
          </button>
        {% endif %}
        {# Salla's modal stays available for currency selection. #}
        {% if store.settings.currencies_enabled %}<salla-localization-modal data-testid="store-header-localization"></salla-localization-modal>{% endif %}
        <div class="core-care-header__delivery"><salla-bullet-delivery-tag></salla-bullet-delivery-tag></div>
        <salla-user-menu data-testid="store-header-user-menu" show-header show-trigger>
          <div slot="trigger"><button class="core-care-header__account" type="button" aria-label="{{ trans('beauty.header.account') }}"><i class="sicon-user" aria-hidden="true"></i><span>{{ trans('beauty.header.account') }}</span><i class="sicon-keyboard_arrow_down" aria-hidden="true"></i></button></div>
        </salla-user-menu>
        <a class="core-care-header__notification" href="{{ link('account/notifications') }}" aria-label="{{ trans('beauty.header.notifications') }}"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></a>
        <salla-cart-summary data-testid="store-header-cart">
          <i slot="icon" class="header-btn__icon icon sicon-shopping-bag" aria-hidden="true"></i>
        </salla-cart-summary>
      </div>
    </div>
    <core-care-categories id="core-care-categories" hidden aria-label="{{ trans('beauty.header.categories') }}"></core-care-categories>
  </div>
</header>
