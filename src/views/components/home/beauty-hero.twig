{# The reference design is the default; merchants can replace its copy, image and link. #}
{% set arabic = language.code starts with 'ar' %}
<section component-id="{{ componentId }}" data-testid="beauty-hero" class="s-block beauty-hero">
  <div class="container beauty-hero__grid">
    <div class="beauty-hero__copy">
      <p class="beauty-hero__offer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.7 3.3C13.5 3.2 7.5 5.4 5.6 10.6c-.8 2.3-.5 4.7.8 6.6 1.7-3 4.3-5 8.5-6.2-3.6 2-5.7 4.4-6.9 8.1a1 1 0 0 0 1.9.6c.4-1.3.9-2.5 1.6-3.6 5.4 1.1 9.4-2.2 9.5-8.7l-.1-4.1Z"/></svg>
        <span>{{ component.eyebrow ?: (arabic ? 'خصم يصل إلى 30٪' : 'Up to 30% off') }}</span>
      </p>
      <h2>{% if component.title %}{{ component.title }}{% elseif arabic %}جمالك الطبيعي،<br>بأيدي خبيرة{% else %}Natural beauty,<br>in expert hands{% endif %}</h2>
      <p class="beauty-hero__description">{{ component.description ?: (arabic ? 'اكتشفي مجموعتنا الحصرية من منتجات العناية بالبشرة المصنوعة من أجود المكونات الطبيعية.' : 'Discover our exclusive skincare collection made with carefully selected natural ingredients.') }}</p>
      <a class="beauty-button beauty-button--gold beauty-hero__action" href="{{ component.button_url ?: store.url }}">
        <span>{{ component.button_label ?: (arabic ? 'تسوقي الآن' : 'Shop now') }}</span>
        <i class="sicon-arrow-left beauty-directional" aria-hidden="true"></i>
      </a>
    </div>

    <div class="beauty-hero__visual">
      <div class="beauty-hero__media">
        <img src="{{ component.image ?: ('images/beauty-hero-products.png'|asset) }}" alt="{{ component.image_alt ?: (arabic ? 'مجموعة منتجات للعناية بالبشرة على قماش حريري' : 'Skincare products on ivory satin') }}" width="1254" height="1254" {% if position == 0 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
      </div>
      <span class="beauty-hero__new">{{ arabic ? 'جديدنا' : 'New' }}<strong>2025</strong></span>
      <div class="beauty-hero__natural">
        <span class="beauty-hero__natural-icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.7 3.3C13.5 3.2 7.5 5.4 5.6 10.6c-.8 2.3-.5 4.7.8 6.6 1.7-3 4.3-5 8.5-6.2-3.6 2-5.7 4.4-6.9 8.1a1 1 0 0 0 1.9.6c.4-1.3.9-2.5 1.6-3.6 5.4 1.1 9.4-2.2 9.5-8.7l-.1-4.1Z"/></svg></span>
        <span>{{ arabic ? 'مكونات طبيعية' : 'Natural ingredients' }}<strong>{{ arabic ? '100٪ طبيعي' : '100% natural' }}</strong></span>
      </div>
    </div>
  </div>

  <div class="beauty-hero__benefits" aria-label="{{ arabic ? 'مزايا التسوق' : 'Shopping benefits' }}">
    <div class="container beauty-hero__benefits-inner">
      <div><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5h11v9H3V5Zm12 3h3.1l2.4 3V14H15V8ZM5 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm11 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0ZM3 15h18v2h-1a4 4 0 0 0-8 0H9a4 4 0 0 0-8 0V7h2v8Z"/></svg><span>{{ arabic ? 'توصيل سريع' : 'Fast delivery' }}</span></div>
      <div><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 8 3v6c0 5.5-3.6 9.3-8 11-4.4-1.7-8-5.5-8-11V5l8-3Zm-1 13 5-5-1.4-1.4-3.6 3.6-1.6-1.6L8 12l3 3Z"/></svg><span>{{ arabic ? 'ضمان الجودة' : 'Quality guaranteed' }}</span></div>
      <div><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3a9 9 0 1 1-8.5 12h2.2A7 7 0 1 0 5 9l2.7 2.7L6.3 13.1 1 7.8l5.3-5.3 1.4 1.4L5.1 6.5A9 9 0 0 1 12 3Z"/></svg><span>{{ arabic ? 'إرجاع سهل' : 'Easy returns' }}</span></div>
      <div><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.7 3.3C13.5 3.2 7.5 5.4 5.6 10.6c-.8 2.3-.5 4.7.8 6.6 1.7-3 4.3-5 8.5-6.2-3.6 2-5.7 4.4-6.9 8.1a1 1 0 0 0 1.9.6c.4-1.3.9-2.5 1.6-3.6 5.4 1.1 9.4-2.2 9.5-8.7l-.1-4.1Z"/></svg><span>{{ arabic ? 'مكونات طبيعية 100٪' : '100% natural ingredients' }}</span></div>
    </div>
  </div>
</section>
