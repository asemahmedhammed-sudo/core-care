{# Optional editorial campaign; preserve merchant fields without fabricated offers/claims. #}
{% if component.image or component.title or component.description %}
<section component-id="{{ componentId }}" data-testid="beauty-hero" class="s-block beauty-hero {{ component.image_first ? 'beauty-hero--image-first' : '' }} {{ component.soft_background == false ? 'beauty-hero--plain' : '' }} {{ component.rounded_image == false ? 'beauty-hero--square-image' : '' }}">
  <div class="container beauty-hero__grid {{ not component.image ? 'beauty-hero__grid--no-image' : '' }}">
    <div class="beauty-hero__copy">
      {% if component.eyebrow %}<p class="beauty-hero__offer">{{ component.eyebrow }}</p>{% endif %}
      {% if component.title %}<h2>{{ component.title }}</h2>{% endif %}
      {% if component.description %}<p class="beauty-hero__description">{{ component.description }}</p>{% endif %}
      {% if component.button_label and component.button_url %}<a class="beauty-button beauty-button--gold beauty-hero__action" href="{{ component.button_url }}"><span>{{ component.button_label }}</span><i class="sicon-arrow-left beauty-directional" aria-hidden="true"></i></a>{% endif %}
    </div>
    {% if component.image %}<div class="beauty-hero__visual"><div class="beauty-hero__media"><img src="{{ component.image }}" alt="{{ component.image_alt }}" width="1000" height="1000" loading="{{ position == 0 ? 'eager' : 'lazy' }}"></div></div>{% endif %}
  </div>
</section>
{% endif %}
