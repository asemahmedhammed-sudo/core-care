{#
| Variable              | Type      | Description                                                      |
|-----------------------|-----------|------------------------------------------------------------------|
| products.source       | string    |                                                                  |
| products.source_value | ?int[]    | ids of sources (product_ids, categories_ids, brands_id..etc)     |
| products.source_value | ?int      | limit of products                                                |
| title                 | string    | Section title                                                    |
| display_all_url       | ?string   | If it's existed, mean should show load more link to this url     |
| position              | Int       | Sorting number start from zero                                   |
| limit                 | int       | Number of products to be shown                                   |
#}

<section component-id="{{ componentId }}" data-testid="store-home-products-slider" id="best-offers-{{ position }}-slider" data-add-to-cart-label="{{ trans('beauty.product_section_add_to_cart') }}" data-view-product-label="{{ trans('beauty.view_product') }}" class="s-block beauty-product-section s-block--best-offers container">
  {% if products|length %}
    {% include 'pages.partials.home.product-section-heading' with { section_title: title, section_subtitle: sub_title } %}
    <salla-products-slider
      data-testid="store-home-products-slider-widget"
      source="{{ products.source }}"
      limit="{{ limit }}"
      source-value="{{ products.source_value|json_encode }}"
      slider-id="slider-with-bg-{{ position }}"
      product-card-component="custom-salla-product-card"
    ></salla-products-slider>
    {% include 'pages.partials.home.product-section-footer' %}
  {% endif %}
</section>
