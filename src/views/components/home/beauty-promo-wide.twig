{% if component.image %}
  <section component-id="{{ componentId }}" data-testid="beauty-promo-wide" class="s-block container beauty-campaigns">
    {% include 'pages.partials.home.promo-banner' with {
      banner: { image: component.image, image_en: component.image_en|default(''), mobile_image: component.mobile_image, mobile_image_en: component.mobile_image_en|default(''), image_alt: component.image_alt, url: component.url },
      language: language
    } only %}
  </section>
{% endif %}
