<footer id="store-footer" data-testid="store-footer" class="store-footer beauty-footer core-care-footer">
  <div class="core-care-footer__support">
    <div class="container core-care-footer__support-layout">
      <div class="core-care-footer__support-intro">
        <h2>{{ trans('beauty.footer.support_title') }}</h2>
        <p>{{ trans('beauty.footer.support_description') }}</p>
      </div>
      <salla-contacts data-testid="store-footer-contacts" hide-title></salla-contacts>
    </div>
  </div>
	<div aria-label="footer" class="store-footer__inner">
		<div class="container core-care-footer__grid">
			<div class="core-care-footer__brand">
				<a href="{{ link('/') }}" class="flex items-center m-0">
					<h3>{{ theme.settings.get('beauty_brand_name', store.name) }}</h3>
				</a>
				{% if store.description %}
					<div class="core-care-footer__description">
						{{ store.description | striptags }}
          </div>
				{% endif %}

				<div class="core-care-footer__social">
					<salla-social data-testid="store-footer-social" class="block mb-6"></salla-social>
				</div>

		<div class="core-care-footer__credentials">
		  {# trust badges #}
		  <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
          {# vat #}
          {% if store.settings.tax.number %}
            <div class="flex rtl:space-x-reverse space-x-2 items-end">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                  <img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-10 rounded-sm hover:opacity-80 transition-opacity" alt="{{ trans('beauty.tax_certificate') }}">
                </a>
              {% endif %}
              <div>
                <p class="text-sm text-text-grey mb-1">{{ trans('common.elements.tax_number') }}</p>
                <b class="text-sm">{{ store.settings.tax.number }}</b>
              </div>
            </div>

            {% if store.settings.tax.certificate %}
              <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                  <img class="w-full" loading="lazy"
                  data-src="{{ store.settings.tax.certificate }}"
                  alt="{{ store.settings.tax.number }}"/>
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>
        </div>

			<div>
				<h3>{{ trans('beauty.footer.quick_links') }}</h3>
				<nav class="core-care-footer__links" aria-label="{{ trans('beauty.footer.quick_links') }}">
					<a href="{{ link('/') }}">{{ trans('beauty.footer.home') }}</a>
					<a href="{{ link('latest-products') }}">{{ trans('beauty.footer.products') }}</a>
					<a href="{{ link('offers') }}">{{ trans('beauty.footer.offers') }}</a>
					<a href="#store-footer">{{ trans('beauty.footer.about') }}</a>
				</nav>
			</div>

			<div class="core-care-footer__service">
				<h3>{{ trans('beauty.footer.customer_service') }}</h3>
				<salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
			</div>
			<div class="core-care-footer__payments">
				<h3>{{ trans('beauty.footer.payment_methods') }}</h3>
				<salla-payments data-testid="store-footer-payments"></salla-payments>
				<salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
			</div>

		</div>
	</div>

	<div class="core-care-footer__bottom container text-center">
		{# Phones only (core-care-app-nav.scss): the compact header has no language/currency icon there, so this
		   opens the header's own language panel or Salla's currency window (core-care-tabbar.js). #}
		{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
		<button class="core-care-footer__localization" type="button" data-cc-localization-open>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
			<span>{{ trans(store.settings.is_multilingual and store.settings.currencies_enabled ? 'beauty.header.localization' : (store.settings.is_multilingual ? 'beauty.header.language' : 'beauty.header.currency')) }}</span>
		</button>
		{% endif %}
		<span class="text-sm copyright-text">{% hook copyright %}</span>
	</div>

<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3 opacity-40"></span></footer>
